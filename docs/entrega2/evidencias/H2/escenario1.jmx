ampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><stringProp name="TestPlan.comments">Escritura. Cada usuario tiene sus propios intentos (maximo 3).</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Cabeceras de la peticion" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Idempotency-Key</stringProp><stringProp name="Header.value">${runId}-u${userIdx}-s${attempt}-submit</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="elige respuestas segun el intento" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">
int k = vars.get(&quot;attempt&quot;) as int
// intento 1: Q1 bien, Q2 mal -&gt; 50 | intento 2: ambas bien -&gt; 100 | intento 3: ambas mal -&gt; 0
vars.put(&quot;ans1&quot;, (k == 3) ? vars.get(&quot;q1o1&quot;) : vars.get(&quot;q1o0&quot;))
vars.put(&quot;ans2&quot;, (k == 2) ? vars.get(&quot;q2o0&quot;) : vars.get(&quot;q2o1&quot;))
</stringProp></JSR223PreProcessor><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="responde con el codigo esperado" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/><JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="la calificacion es la esperada para el intento" enabled="true"><stringProp name="JSON_PATH">$.score</stringProp><stringProp name="EXPECTED_VALUE">${expectedScore}</stringProp><boolProp name="JSONVALIDATION">true</boolProp><boolProp name="EXPECT_NULL">false</boolProp><boolProp name="INVERT">false</boolProp><boolProp name="ISREGEX">false</boolProp></JSONPathAssertion><hashTree/><JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="es el intento numero esperado" enabled="true"><stringProp name="JSON_PATH">$.attempt</stringProp><stringProp name="EXPECTED_VALUE">${attempt}</stringProp><boolProp name="JSONVALIDATION">true</boolProp><boolProp name="EXPECT_NULL">false</boolProp><boolProp name="INVERT">false</boolProp><boolProp name="ISREGEX">false</boolProp></JSONPathAssertion><hashTree/><JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="intentos restantes correctos" enabled="true"><stringProp name="JSON_PATH">$.attempts_remaining</stringProp><stringProp name="EXPECTED_VALUE">${attemptsRemaining}</stringProp><boolProp name="JSONVALIDATION">true</boolProp><boolProp name="EXPECT_NULL">false</boolProp><boolProp name="INVERT">false</boolProp><boolProp name="ISREGEX">false</boolProp></JSONPathAssertion><hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPo