# Ejemplo de /opt/mooc/.env en una instancia del grupo de API (`mooc-api-group`)
# Generado en el arranque por `scripts/prepare_web_env.sh` con modo 0600.
# NUNCA se versiona en Git ni entra en las imagenes Docker (`.dockerignore`).
#
# Los dos secretos (`db-password` y `smtp-password`) se consultan en tiempo de
# ejecucion a Secret Manager usando la cuenta de servicio adjunta `sa-web-server`.
IMAGE_TAG='0000000000000000000000000000000000000000'
APP_ENV='production'
NGINX_CONFIG_FILE='./nginx.web.conf'
APP_DOMAIN='<IP_PUBLICA_BALANCEADOR>.sslip.io'
APP_BASE_URL='https://<IP_PUBLICA_BALANCEADOR>.sslip.io'
CSRF_ALLOWED_ORIGINS='https://<IP_PUBLICA_BALANCEADOR>.sslip.io'
TRUSTED_PROXY_IP='172.30.0.2'
INSTANCE_ID='<ID_NUMERICO_GCE_METADATA>'
REDIS_SESSION_DB='1'
SESSION_COOKIE_SAMESITE='lax'
DATABASE_URL='postgres://moocuser:<SECRETO_URL_ENCODED_DB_PASSWORD>@<IP_PRIVADA_CLOUDSQL>:5432/moocdb?sslmode=require'
REDIS_URL='<IP_PRIVADA_COLA_COMPARTIDA>:6379'
STORAGE_BACKEND='gcs'
S3_BUCKET='plataforma-mooc-entrega2-media'
GCP_PROJECT_ID='plataforma-mooc-entrega2'
GCS_SIGNER_ACCOUNT='sa-web-server@plataforma-mooc-entrega2.iam.gserviceaccount.com'
SMTP_HOST='smtp-relay.brevo.com'
SMTP_PORT='587'
SMTP_FROM='<REMITENTE_VERIFICADO_EN_PROVEEDOR_SMTP>'
SMTP_USERNAME='<LOGIN_DEL_PROVEEDOR_SMTP>'
SMTP_PASSWORD='<SECRETO_DESDE_SECRET_MANAGER_SMTP_PASSWORD>'
DB_MAX_OPEN_CONNS='25'
DB_MAX_IDLE_CONNS='25'
DB_CONN_MAX_LIFETIME='5m'
PROXY_IMAGE='us-east1-docker.pkg.dev/plataforma-mooc-entrega2/mooc/web:0000000000000000000000000000000000000000'

