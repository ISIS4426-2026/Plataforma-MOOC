# Ejemplo de /opt/mooc/.env en una instancia del grupo de workers (`mooc-worker-group`)
# Generado en el arranque por `scripts/prepare_worker_env.sh` con modo 0600.
# NUNCA se versiona en Git ni entra en las imagenes Docker (`.dockerignore`).
#
# El unico secreto que lee el worker es `db-password` desde Secret Manager con
# su cuenta adjunta `sa-worker-server`. No tiene permiso sobre `smtp-password`.
IMAGE_TAG='0000000000000000000000000000000000000000'
APP_ENV='production'
DATABASE_URL='postgres://moocuser:<SECRETO_URL_ENCODED_DB_PASSWORD>@<IP_PRIVADA_CLOUDSQL>:5432/moocdb?sslmode=require'
REDIS_URL='<IP_PRIVADA_COLA_COMPARTIDA>:6379'
STORAGE_BACKEND='gcs'
S3_BUCKET='plataforma-mooc-entrega2-media'
MEDIA_HLS_BUCKET='plataforma-mooc-entrega2-hls'
GCP_PROJECT_ID='plataforma-mooc-entrega2'
WORKER_CONCURRENCY='2'
WORKER_DRAIN_TIMEOUT='90s'
MEDIA_WORK_DIR='/tmp/mooc-media'
MEDIA_MAX_ORIGINAL_MB='2048'
DB_MAX_OPEN_CONNS='25'
DB_MAX_IDLE_CONNS='25'
DB_CONN_MAX_LIFETIME='5m'

