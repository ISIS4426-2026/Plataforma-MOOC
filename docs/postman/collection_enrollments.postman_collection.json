    {
      "name": "20 El autor lee la lista de inscritos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"incluye al estudiante inscrito\", function () {",
