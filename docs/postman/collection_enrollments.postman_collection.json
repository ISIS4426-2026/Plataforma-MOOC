    {
      "name": "10 Inscripcion en el curso publicado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// La captura va fuera de pm.test a proposito: dentro, una asercion que",
              "// falle corta el callback y la variable nunca se fija, convirtiendo un",
              "// fallo en seis en cascada.",
              "pm.environment.set(\"enrollmentId\", pm.response.json().id);",
              "pm.test(\"responde 200\", function () { pm.response.to.have.status(200); });",
              "// 200 y no 201: la operacion es idempotente, y decir \"creado\" cuando no se",
              "// creo nada seria una mentira sobre la que el cliente puede actuar.",
              "pm.test(\"queda activa, sobre el stable_id del curso y sin fecha de retiro\", function () {",
              "    var d = pm.response.json();",
              "    pm.expect(d.status).to.eql(\"active\");",
              "    pm.expect(d.course_stable_id).to.be.a(\"string\").that.is.not.empty;",
              "    pm.expect(d.withdrawn_at).to.be.undefined;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
