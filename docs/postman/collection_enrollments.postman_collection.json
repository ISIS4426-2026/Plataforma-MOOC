          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () { pm.response.to.have.status(200); });",
              "// No estar inscrito es una respuesta, no un 404. Se afirma sobre enrolled y",
              "// no sobre la ausencia del registro: tras una corrida previa el registro",
              "// existe, retirado, y eso tambien es \"no inscrito\".",
              "pm.test(\"enrolled es false\", function () {",
