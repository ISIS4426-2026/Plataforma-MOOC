          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () { pm.response.to.have.status(200); });",
              "// Seccion 5.1 del enunciado: reinscripcion conservando progreso. El progreso",
              "// se llavea por (estudiante, course_stable_id), el mismo par que la inscripcion,",
              "// asi que revivir la fila es lo que lo conserva.",
              "pm.test(\"vuelve a activa reutilizando el registro\", function () {",
              "    var d = pm.response.json();",
              "    pm.expect(d.status).to.eql(\"active\");",
              "    pm.expect(d.id).to.eql(pm.environment.get(\"enrollmentId\"));",
