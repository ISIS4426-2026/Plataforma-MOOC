  "item": [
    {
      "name": "01 Login como Administrador Principal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('devuelve token Bearer y datos de usuario admin', () => {",
              "  pm.expect(body.token).to.be.a('string').and.not.empty;",
              "  pm.expect(body.user.role).to.eql('administrador');",
              "  pm.expect(body.user.status).to.eql('active');",
              "});",
              "pm.collectionVariables.set('adminToken', body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "02 Listar usuarios (Paginacion y Estructura)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('estructura de listado con paginacion y usuarios', () => {",
              "  pm.expect(body.items).to.be.an('array').with.lengthOf.at.least(1);",
              "  pm.expect(body.pagination).to.be.an('object');",
              "  pm.expect(body.pagination).to.have.property('has_more');",
              "  const first = body.items[0];",
              "  pm.expect(first).to.have.property('id');",
              "  pm.expect(first).to.have.property('email');",
              "  pm.expect(first).to.have.property('role');",
              "  pm.expect(first).to.have.property('status');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/users?limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "users"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
