        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/courses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "courses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Arquitectura Cloud y Sistemas Distribuidos Avanzados\",\n  \"description\": \"Curso completo de microservicios, mensajería y resiliencia en la nube.\"\n}",
