    {
      "name": "03 Intento de publicacion con errores (espera 422 validation_failed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 422\", function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "pm.test(\"lista exhaustiva de errores de validacion\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.code).to.eql(\"validation_failed\");",
              "    pm.expect(data.details).to.be.an(\"array\").that.is.not.empty;",
              "    var fields = data.details.map(function(d) { return d.field; });",
              "    pm.expect(fields).to.include(\"structure\");",
              "    pm.expect(fields).to.include(\"approval_criteria\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{professorToken}}",
            "type": "text"
          }
        ],
