{
  "info": {
    "_postman_id": "7f65a123-91bc-4e58-8b77-d5d8361099b2",
    "name": "Plataforma MOOC - Autoria de Cursos",
    "description": "Suite de pruebas automatizadas para el subsistema de Autoría de Cursos (Issue #26). Cubre creación de jerarquía de 4 niveles (Curso -> Módulo -> Unidad -> Recurso), previsualización con ETag, validación exhaustiva de publicación (422), inmutabilidad de versión publicada (409), reordenamiento con preservación de identificadores estables (stable_id), despublicación temporal (MVP 5.1) y seguridad RBAC (403/401).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Login como Profesor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"devuelve token Bearer y usuario profesor\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.token).to.be.a(\"string\").that.is.not.empty;",
              "    pm.expect(data.user).to.be.an(\"object\");",
              "    pm.expect(data.user.role).to.eql(\"profesor\");",
              "    pm.environment.set(\"professorToken\", data.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{professorEmail}}\",\n  \"password\": \"{{professorPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "02 Crear Curso en Borrador (Draft)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"curso creado en estado draft y version 1\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.id).to.be.a(\"string\").that.is.not.empty;",
              "    pm.expect(data.stable_id).to.be.a(\"string\").that.is.not.empty;",
              "    pm.expect(data.status).to.eql(\"draft\");",
              "    pm.expect(data.version).to.eql(1);",
              "    pm.expect(data.title).to.eql(\"Arquitectura Cloud y Sistemas Distribuidos Avanzados\");",
              "    pm.environment.set(\"courseId\", data.id);",
              "    pm.environment.set(\"courseStableId\", data.stable_id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{professorToken}}",
            "type": "text"
