    {
      "name": "14 Verificar Reordenamiento y Preservacion de Identificadores Estables",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"reordenamiento exitoso sin huecos y stable_id intacto\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.items).to.be.an(\"array\").with.lengthOf(2);",
              "    pm.expect(data.items[0].id).to.eql(pm.environment.get(\"resource1Id\"));",
              "    pm.expect(data.items[0].stable_id).to.eql(pm.environment.get(\"resource1StableId\"));",
              "    pm.expect(data.items[0].position).to.eql(0);",
              "    pm.expect(data.items[1].id).to.eql(pm.environment.get(\"resource3Id\"));",
              "    pm.expect(data.items[1].stable_id).to.eql(pm.environment.get(\"resource3StableId\"));",
              "    pm.expect(data.items[1].position).to.eql(1);",
              "    pm.expect(data.items[1].title).to.eql(\"Quiz Unidad 1\");",
              "});"
            ]
          }
        }
