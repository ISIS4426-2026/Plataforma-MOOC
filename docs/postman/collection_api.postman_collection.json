      "name": "20 Mailpit: buscar el correo de recuperacion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "const m = pm.response.json().messages[0];",
              "pm.test('llego el correo de recuperacion', () => pm.expect(m).to.not.be.undefined);",
              "pm.test('es el mensaje de recuperacion', () => pm.expect(m.Subject).to.include('Restablece'));",
              "pm.collectionVariables.set('messageId', m.ID);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{mailpitUrl}}/api/v1/search?query=to:{{testEmail}}&limit=1",
          "host": [
            "{{mailpitUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "search"
          ],
          "query": [
            {
              "key": "query",
              "value": "to:{{testEmail}}"
            },
            {
              "key": "limit",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "21 Mailpit: extraer el token de recuperacion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "const cuerpo = pm.response.json().Text || '';",
              "const m = cuerpo.match(/token=([A-Za-z0-9_\\-%]+)/);",
              "pm.test('el correo trae un enlace de recuperacion', () => pm.expect(m).to.not.be.null);",
              "if (m) { pm.collectionVariables.set('resetToken', decodeURIComponent(m[1])); }",
              "pm.test('el enlace apunta al endpoint de reseteo', () =>",
              "  pm.expect(cuerpo).to.include('/api/v1/auth/password/reset?token='));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{mailpitUrl}}/api/v1/message/{{messageId}}",
          "host": [
            "{{mailpitUrl}}"
