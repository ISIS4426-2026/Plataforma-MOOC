            "type": "text/javascript",
            "exec": [
              "pm.test('responde 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "",
              "pm.test('devuelve un token de sesion', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
              "pm.test('devuelve la fecha de expiracion', () => pm.expect(body.expires_at).to.be.a('string'));",
              "pm.test('la respuesta no expone la contrasena', () =>",
              "  pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('testPassword')));",
              "",
              "pm.collectionVariables.set('sessionToken', body.token);"
            ]
          }
