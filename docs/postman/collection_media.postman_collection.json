    {
      "name": "05 Crear recurso de video",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"nace sin objeto asociado\", function () {",
              "    var d = pm.response.json();",
              "    pm.expect(d.type).to.eql(\"video\");",
              "    pm.expect(d.object_key === undefined || d.object_key === \"\").to.be.true;",
              "    pm.environment.set(\"mediaResourceId\", d.id);",
              "    pm.environment.set(\"mediaResourceStableId\", d.stable_id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{professorToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clase magistral 1\",\n  \"type\": \"video\",\n  \"is_visible\": true,\n  \"is_mandatory\": true,\n  \"allow_download\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
