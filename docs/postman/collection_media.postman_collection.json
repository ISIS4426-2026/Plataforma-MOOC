    {
      "name": "06 Solicitar URL prefirmada de carga",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"la clave va bajo originals/<stable_id>/ y descarta el nombre del cliente\", function () {",
              "    var d = pm.response.json();",
              "    pm.expect(d.object_key).to.have.string(\"originals/\" + pm.environment.get(\"mediaResourceStableId\") + \"/\");",
              "    pm.expect(d.object_key).to.not.have.string(\"clase\");",
              "    pm.expect(d.object_key).to.have.string(\".mp4\");",
              "});",
              "pm.test(\"declara el metodo y el content-type que cubre la firma\", function () {",
              "    var d = pm.response.json();",
              "    pm.expect(d.method).to.eql(\"PUT\");",
              "    pm.expect(d.content_type).to.eql(\"video/mp4\");",
              "    pm.expect(d.upload_url).to.be.a(\"string\").that.is.not.empty;",
              "    pm.environment.set(\"uploadUrl\", d.upload_url);",
              "    pm.environment.set(\"mediaObjectKey\", d.object_key);",
              "});",
              "pm.test(\"vence en 24 horas, como pide el enunciado\", function () {",
              "    var horas = (new Date(pm.response.json().expires_at) - Date.now()) / 3600000;",
              "    pm.expect(horas).to.be.above(23);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{professorToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resource_id\": \"{{mediaResourceId}}\",\n  \"filename\": \"clase.mp4\",\n  \"mime_type\": \"video/mp4\",\n  \"file_size_bytes\": 2048\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
