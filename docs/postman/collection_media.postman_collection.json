    {
      "name": "07 Carga directa al bucket (el archivo no pasa por la API)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Newman corre dentro de la red de compose, asi que el host firmado",
              "// (minio:9000) resuelve. Desde el host no resolveria: la firma cubre el",
              "// host y reescribirlo la invalida. Ver docs/entrega2/NOTAS_TECNICAS.md.",
              "pm.test(\"el bucket acepta la transferencia\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "video/mp4",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "bytes de prueba que hacen las veces de un mp4",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{uploadUrl}}",
          "host": [
            "{{uploadUrl}}"
          ]
        }
      },
      "response": []
    },
