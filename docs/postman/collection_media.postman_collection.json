    {
      "name": "09 Reconfirmar la misma carga (idempotente)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// La clave de idempotencia del trabajo sale del object_key. La cola rechaza",
              "// el segundo encolado y el servicio lo trata como exito: el trabajo ya existe.",
              "// Una entrega duplicada no genera salidas repetidas.",
              "pm.test(\"sigue respondiendo 202, no 500\", function () { pm.response.to.have.status(202); });",
              "pm.test(\"el estado no cambia\", function () {",
              "    pm.expect(pm.response.json().processing_status).to.eql(\"pending\");",
              "});"
            ]
          }
        }
      ],
