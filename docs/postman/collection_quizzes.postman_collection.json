              "// Primer criterio de aceptacion. La clave de idempotencia hace que un",
              "// reintento devuelva la calificacion ya registrada en lugar de gastar",
              "// otro intento: es lo que protege a un cliente que reintenta tras un",
              "// tiempo de espera agotado.",
              "//",
              "// La concurrencia real no se puede reproducir con newman, que es",
              "// secuencial; la cubre TestQuizRepositoryConcurrentSubmissionsRespectTheLimit.",
              "pm.test(\"devuelve exactamente la misma calificacion\", function () {",
              "    var d = pm.response.json();",
              "    pm.expect(d.submission_id).to.eql(pm.environment.get(\"envioIntento2\"));",
              "    pm.expect(d.attempt).to.eql(2);",
              "    pm.expect(String(d.score)).to.eql(pm.environment.get(\"scoreIntento2\"));",
              "});"
