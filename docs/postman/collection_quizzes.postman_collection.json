    {
      "name": "14 El autor lee el cuestionario CON la clave",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"responde 200\", function () { pm.response.to.have.status(200); });",
              "// El autor necesita ver la clave: es la que acaba de escribir.",
              "pm.test(\"trae questions_with_key y no questions\", function () {",
              "    var d = pm.response.json();",
              "    pm.expect(d.questions_with_key).to.be.an(\"array\").with.lengthOf(2);",
              "    pm.expect(d.questions).to.be.undefined;",
              "});",
              "pm.test(\"cada pregunta tiene exactamente una correcta\", function () {",
              "    pm.response.json().questions_with_key.forEach(function (q) {",
              "        var correctas = q.options.filter(function (o) { return o.is_correct; });",
              "        pm.expect(correctas).to.have.lengthOf(1);",
              "    });",
              "});",
              "// Se guardan los ids para poder responder bien y mal mas adelante.",
              "var d = pm.response.json();",
              "var buenas = [], malas = [];",
              "d.questions_with_key.forEach(function (q) {",
              "    q.options.forEach(function (o) {",
              "        var par = { question_id: q.id, selected_option_id: o.id };",
              "        if (o.is_correct) { buenas.push(par); } else { malas.push(par); }",
              "    });",
              "});",
              "pm.environment.set(\"respuestasCorrectas\", JSON.stringify(buenas));",
              "pm.environment.set(\"respuestasIncorrectas\", JSON.stringify(malas));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{professorToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/resources/{{quizResourceId}}/quiz",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "resources",
            "{{quizResourceId}}",
            "quiz"
          ]
        }
      },
      "response": []
    },
