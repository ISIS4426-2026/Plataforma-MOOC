# ==============================================================================
# Plataforma MOOC - Documentación de Variables de Entorno (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración de Aplicación (API REST & Worker)
# ------------------------------------------------------------------------------
# Entorno de ejecución (development, staging, production)
APP_ENV=development

# Puerto expuesto por el servidor HTTP de la API REST
API_PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL (Base de Datos Relacional Transactional)
# ------------------------------------------------------------------------------
# Usuario de PostgreSQL
POSTGRES_USER=moocuser

# Contraseña del usuario de PostgreSQL
POSTGRES_PASSWORD=moocpassword

# Nombre de la base de datos PostgreSQL
POSTGRES_DB=moocdb

# Puerto expuesto de PostgreSQL en el host
POSTGRES_PORT=5432

# URL de conexión a la base de datos (usada por API y Worker)
DATABASE_URL=postgres://moocuser:moocpassword@postgres:5432/moocdb?sslmode=disable

# ------------------------------------------------------------------------------
# Redis (Cache, In-Memory Store & Cola de Tareas Asynq)
# ------------------------------------------------------------------------------
# Puerto expuesto de Redis en el host
REDIS_PORT=6379

# Dirección de conexión a Redis (host:puerto)
REDIS_URL=redis:6379

# ------------------------------------------------------------------------------
# MinIO (Almacenamiento de Objetos S3-Compatible)
# ------------------------------------------------------------------------------
# Usuario Administrador de MinIO (Access Key)
MINIO_ROOT_USER=minioadmin

# Contraseña del Administrador de MinIO (Secret Key)
MINIO_ROOT_PASSWORD=minioadmin

# Puerto de la API S3 de MinIO expuesto en el host
MINIO_PORT=9000

# Puerto de la Consola Web de MinIO expuesto en el host
MINIO_CONSOLE_PORT=9001

# Endpoint HTTP de MinIO para acceso S3 desde los contenedores
S3_ENDPOINT=http://minio:9000

# Nombre del bucket inicial para recursos binarios (videos, PDFs, imágenes, insignias)
S3_BUCKET=mooc-storage

# ------------------------------------------------------------------------------
# Mailpit (Servidor SMTP & Interfaz Web para Pruebas de Correo)
# ------------------------------------------------------------------------------
# Puerto de la Consola Web UI de Mailpit (Inspector de emails)
MAILPIT_PORT=8025

# Puerto SMTP de Mailpit para captura de correos electrónicos en desarrollo
MAILPIT_SMTP_PORT=1025
