# ==============================================================================
# Plataforma MOOC - Documentación de Variables de Entorno (.env.example)
# ==============================================================================

# ==============================================================================
# SECRETOS  (issue #117)
#
# Las variables marcadas con [SECRETO] van VACIAS en este archivo, siempre.
# Se rellenan en el .env local --que esta en .gitignore-- y en la nube se
# inyectan en ejecucion desde Secret Manager. Nunca se escriben aqui, ni en
# docker-compose.yml, ni en una imagen.
#
# Las que no llevan esa marca traen el valor de desarrollo, y eso es
# deliberado: quien clona el repositorio debe poder levantar Docker Compose sin
# configurar nada. Ninguna protege nada real -- son las credenciales de unos
# contenedores que solo existen en la maquina de quien los levanta.
#
# En produccion, arrancar con cualquiera de esos valores de desarrollo esta
# impedido: internal/config/validate.go rechaza el arranque y dice cual falta.
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración de Aplicación (API REST & Worker)
# ------------------------------------------------------------------------------
# Entorno de ejecución (development, staging, production)
APP_ENV=development

# Puerto expuesto por el servidor HTTP de la API REST
API_PORT=8080

# Puerto donde el worker expone metricas Prometheus (GET /metrics), en el
# host. La API expone las suyas junto al resto de /api/v1 (GET /api/v1/metrics)
# en API_PORT; el worker no tiene otro servidor HTTP, asi que usa el suyo.
WORKER_METRICS_PORT=9090

# ------------------------------------------------------------------------------
# PostgreSQL (Base de Datos Relacional Transactional)
# ------------------------------------------------------------------------------
# Usuario de PostgreSQL
POSTGRES_USER=moocuser

# Contraseña del usuario de PostgreSQL
# [SECRETO] en la nube lo gestiona Terraform desde TF_VAR_db_password.
POSTGRES_PASSWORD=

# Nombre de la base de datos PostgreSQL
POSTGRES_DB=moocdb

# Puerto expuesto de PostgreSQL en el host
POSTGRES_PORT=5432

# URL de conexión a la base de datos (usada por API y Worker)
# [SECRETO] Contiene la contrasena. En la nube se arma con la de Secret Manager.
# Local: postgres://moocuser:<POSTGRES_PASSWORD>@postgres:5432/moocdb?sslmode=disable
DATABASE_URL=

# Tamaño máximo del pool de conexiones por instancia de API/Worker.
# La API y los workers escalan horizontalmente, así que cada instancia debe
# acotar su parte de max_connections de PostgreSQL en lugar de abrir sin límite.
DB_MAX_OPEN_CONNS=25

# Conexiones inactivas que se mantienen abiertas para reutilizar
DB_MAX_IDLE_CONNS=25

# Tiempo de vida máximo de una conexión antes de reciclarla
DB_CONN_MAX_LIFETIME=5m

# ------------------------------------------------------------------------------
# Redis (Cache, In-Memory Store & Cola de Tareas Asynq)
# ------------------------------------------------------------------------------
# Puerto expuesto de Redis en el host
REDIS_PORT=6379

# Dirección de conexión a Redis (host:puerto)
REDIS_URL=redis:6379

# ------------------------------------------------------------------------------
# MinIO (Almacenamiento de Objetos S3-Compatible)
# ------------------------------------------------------------------------------
# Usuario Administrador de MinIO (Access Key)
MINIO_ROOT_USER=minioadmin

# Contraseña del Administrador de MinIO (Secret Key)
# [SECRETO] solo local: en la nube no hay MinIO.
MINIO_ROOT_PASSWORD=

# Puerto de la API S3 de MinIO expuesto en el host
MINIO_PORT=9000

# Endpoint HTTP de almacenamiento. En local apunta a MinIO (http://minio:9000).
# En la nube se usa el endpoint de Cloud Storage (https://storage.googleapis.com).
S3_ENDPOINT=http://minio:9000

# Nombre del bucket para recursos binarios.
# Local: mooc-storage
# Nube (C3/C4): plataforma-mooc-entrega2-media
S3_BUCKET=mooc-storage

# ID del proyecto de GCP (usado en la nube para identificar el proyecto y recursos)
GCP_PROJECT_ID=plataforma-mooc-entrega2

# Adaptador de almacenamiento de objetos: minio (desarrollo local) o gcs (nube).
# Se elige en ejecución, no en compilación, para que el mismo binario corra en
# ambos entornos y el camino desplegado sea uno que el equipo ya ejercitó.
# En producción (APP_ENV=production) validate.go EXIGE STORAGE_BACKEND=gcs.
STORAGE_BACKEND=minio

# Credenciales S3 para el adaptador minio. Con STORAGE_BACKEND=gcs se ignoran:
# ahí las credenciales vienen de la service account adjunta a la VM (sa-web-server
# o sa-worker-server), nunca de un archivo de llaves en el repositorio.
# [SECRETO] solo local. Con STORAGE_BACKEND=gcs no se usa.
S3_ACCESS_KEY=
# [SECRETO] solo local. Con STORAGE_BACKEND=gcs no se usa.
S3_SECRET_KEY=

# Vigencia de la URL firmada de carga. El enunciado del proyecto pide carga
# reanudable durante 24 horas.
MEDIA_UPLOAD_URL_TTL=24h

# Vigencia de la URL firmada de lectura. Mucho más corta a propósito: una URL
# de lectura filtrada es una copia del contenido.
MEDIA_DOWNLOAD_URL_TTL=1h

# Tamaño máximo autorizado por carga, en MB
MEDIA_MAX_UPLOAD_MB=1024

# Tamaño máximo que el worker acepta procesar, en MB. Es su propia guarda,
# distinta del tope de carga: una URL firmada no se puede limitar en el bucket
# y la VM solo tiene 30 GiB de disco.
MEDIA_MAX_ORIGINAL_MB=2048

# Directorio de trabajo del worker para originales y rendiciones. Vacío usa el
# temporal del sistema; la imagen lo fija en /tmp/mooc-media.
MEDIA_WORK_DIR=

# Escalera HLS declarada, como entradas `alto:videoKbps:audioKbps` separadas por
# coma. Vacío usa 360:800:96,720:2500:128.
#
# Nunca se hace upscaling: la escalera acota lo que se puede producir, no obliga
# a superar la resolución del original. Cambiarla altera el costo de CPU por
# trabajo, así que una corrida de capacidad debe registrar el valor que usó.
MEDIA_HLS_LADDER=

# ------------------------------------------------------------------------------
# Mailpit (Servidor SMTP & Interfaz Web para Pruebas de Correo)
# ------------------------------------------------------------------------------
# Puerto de la Consola Web UI de Mailpit (Inspector de emails)
MAILPIT_PORT=8025

# Puerto SMTP de Mailpit para captura de correos electrónicos en desarrollo
MAILPIT_SMTP_PORT=1025

# Host SMTP usado por la API para enviar correos de verificación y recuperación.
# En desarrollo apunta al contenedor de Mailpit, donde los mensajes se inspeccionan
# sin salir a Internet.
SMTP_HOST=mailpit

# Puerto SMTP al que se conecta la API (el puerto interno de Mailpit)
SMTP_PORT=1025

# Remitente de los correos transaccionales
SMTP_FROM=no-reply@plataforma-mooc.local

# Credenciales SMTP. Vacías en desarrollo porque Mailpit no exige autenticación;
# en producción se inyectan desde el gestor externo de secretos.
# [SECRETO] usuario del proveedor SMTP (issue #126).
SMTP_USERNAME=
# [SECRETO] credencial del proveedor SMTP (issue #126).
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# Sesiones
# ------------------------------------------------------------------------------
# Vigencia de una sesión emitida al iniciar sesión
SESSION_TTL=24h

# Origen publico desde el que se sirve la plataforma. Los enlaces de verificacion
# se construyen con esta URL, asi que debe ser la direccion que el navegador del
# usuario puede alcanzar, no el nombre del contenedor.
APP_BASE_URL=http://localhost:8080

# Vigencia del enlace de verificacion de correo
EMAIL_VERIFICATION_TTL=24h

# Vigencia del enlace de recuperacion de contrasena. Mas corto que el de
# verificacion porque permite un cambio inmediato de credenciales.
PASSWORD_RESET_TTL=1h

# ------------------------------------------------------------------------------
# Seguridad: CSRF y limites de tasa
# ------------------------------------------------------------------------------
# Origenes autorizados a enviar peticiones que cambian estado, separados por
# comas (ej: https://app.plataforma-mooc.com,http://localhost:3000).
# Vacio desactiva la comprobacion, que es lo correcto mientras no exista un
# cliente de navegador: sin frontend desplegado no hay origen que confiar.
CSRF_ALLOWED_ORIGINS=

# Cuanto tiempo se recuerda la respuesta de una peticion con Idempotency-Key.
# Acota hasta cuando un reintento se sigue reconociendo como tal; pasado ese
# plazo la peticion vuelve a ejecutarse.
IDEMPOTENCY_TTL=24h

# Umbrales de rate limiting por direccion IP. Estos valores estan dimensionados
# para desarrollo; en produccion conviene apretarlos, sobre todo el de login.
#
# Login: protege contra adivinacion de credenciales.
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW=1m

# Registro: evita la creacion masiva de cuentas.
RATE_LIMIT_REGISTER_ATTEMPTS=50
RATE_LIMIT_REGISTER_WINDOW=1h

# Recuperacion y reenvio de verificacion: evita inundar buzones ajenos.
RATE_LIMIT_RECOVERY_ATTEMPTS=50
RATE_LIMIT_RECOVERY_WINDOW=1h

# ------------------------------------------------------------------------------
# DESPLIEGUE EN LA NUBE  (issue #117)
# ------------------------------------------------------------------------------
# Lo que cambia respecto al entorno local. Estos valores NO van en el .env del
# repositorio: los inyecta el Compose de la VM, leyendolos de Secret Manager.

# Activa las comprobaciones de arranque de internal/config/validate.go. Con
# cualquier otro valor no se comprueba nada, que es lo que hace comodo el
# desarrollo local.
# APP_ENV=production

# El almacenamiento administrado. Con gcs no hay credenciales que configurar:
# las toma de la cuenta de servicio adjunta a la VM.
# STORAGE_BACKEND=gcs
# S3_BUCKET=<nombre-del-bucket-de-C3>

# El origen publico de la plataforma. Arma los enlaces de activacion, de
# recuperacion de contrasena y de verificacion de insignias. Si queda en
# localhost no falla nada de forma visible: los correos se envian y los enlaces
# simplemente no abren.
# APP_BASE_URL=https://<dominio-o-ip-publica>

# Origenes permitidos para CSRF, detras del proxy inverso del issue #124.
# CSRF_ALLOWED_ORIGINS=https://<dominio-o-ip-publica>

# Conexion privada a Cloud SQL (issue #118). La contrasena viene de Secret
# Manager, nunca de este archivo. La IP privada la da `terraform output
# db_private_ip`, y es la unica direccion que tiene la instancia.
#
# El `sslmode=require` es obligatorio por dos lados: la instancia esta en
# ENCRYPTED_ONLY y rechaza las conexiones en claro, y el arranque en produccion
# tambien lo exige (internal/config/validate.go). Sin el, el proceso no arranca
# y dice por que -- que es mejor que un fallo de conexion cuyo mensaje no
# menciona el cifrado.
# DATABASE_URL=postgres://moocuser:<contrasena>@<ip-privada>:5432/moocdb?sslmode=require

# El pool, frente al limite de la instancia administrada (issue #118).
#
# Los valores por defecto de arriba --25 abiertas, 25 inactivas-- ya estan
# dimensionados y no hay que cambiarlos. El reparto de las 100 conexiones que
# declara infra/terraform/database.tf:
#
#   API (esta VM)                   25
#   Worker (la otra VM)             25
#   Reserva de superusuario          3
#   Agentes de Google               ~5
#   -------------------------------------
#   Comprometido                   ~58   de 100
#
# Lo que hay que recordar es que **son dos VMs sumando contra el mismo tope**.
# Subir DB_MAX_OPEN_CONNS aqui lo sube para una sola de las dos, y el margen que
# queda es para las migraciones, un psql de diagnostico y el solapamiento de un
# reinicio. El limite efectivo se comprueba con:
#
#     bash ./scripts/migrate.sh --verify
#
# Las inactivas se dejan igual a las abiertas a proposito: contra Cloud SQL cada
# conexion nueva paga un saludo TLS, y en el escenario 1 interesa medir la
# plataforma, no los saludos. El tope de vida de 5 minutos las recicla de todas
# formas, que es lo que hace que una ventana de mantenimiento no deje conexiones
# muertas en el pool.

# SMTP real (issue #126). Brevo usa 587 por defecto. También admite 465 (TLS
# directo) y 2525 como alternativa en redes restrictivas; Google bloquea el 25.
# La clave SMTP vive en Secret Manager. El login y el remitente verificado se
# configuran solo en /etc/mooc/web.conf de la VM, nunca en este archivo.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_FROM=<remitente-verificado>
# SMTP_USERNAME=<login-smtp-mostrado-por-brevo>
# SMTP_PASSWORD=<secret-manager:smtp-password>
